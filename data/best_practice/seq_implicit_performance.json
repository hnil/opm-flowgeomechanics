   "__1_propagation_growth": "--- fracture grid growth / trimesh propagation (KEEP fidelity here) ---",
   "area_change_fac": 1.2,
   "dt_limit": 10,
   "efac": "0.5",
   "rfac": "0.1",
   "max_expand_iter": "20",
   "max_iter_on_same_level": "100000000",
