   "enable_wi_coupling_update": false,
   "coupling_relax_init": 1.0,
   "coupling_relax_min": 0.05,
   "coupling_relax_max": 1.25,
   "coupling_acceptance_factor": 1.0,
   "coupling_fallback_legacy": true,
