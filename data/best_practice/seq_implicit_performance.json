   "linsolver": {
    "tol": "1e-10",
    "atol": "1e-20",
    "max_iter": "100",
    "verbosity": "0",
    "solver": "bicgstab",
    "preconditioner": {
     "verbosity": 0,
     "diag_mech": "false",
     "diag_flow": "false",
     "mech_first": false,
     "fixed_stress": false,
     "mode_policy": "manual",
     "mode_switch_coupling_threshold": 0.25,
     "mech_press_coupling": "true",
     "update_mech_on_reuse": false,
     "flow_solver": {
      "solver": "umfpack",
      "verbosity": "0",
      "tol": "1",
      "maxiter": 1,
      "preconditioner": {
       "type": "DILU",
       "verbosity": 0
      }
     }
    }
   },
   "wi_vector_acceleration": "anderson"
  },
  "reservoir": {
   "dist": "1",
   "calculate_dist": "true",
   "mobility": "0.0013",
   "perm": "1e-13"
  },
  "control": {
   "type": "perf_pressure",
   "rate": "0.029",
   "WI": "1e-6"
  }
 }
}